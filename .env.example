# ── Development (no auth) ──────────────────────────────────────────────────────
# Set this to skip all JWT checks. Never use in production.
# AUTH_DISABLED=true

# ── Production ─────────────────────────────────────────────────────────────────
# Run `bun run keygen` to generate these values
PRIVATE_KEY_JWK=<base64-encoded-ed25519-private-jwk>
PUBLIC_KEY_JWK=<base64-encoded-ed25519-public-jwk>

# Secret used to protect the POST /token endpoint
ADMIN_SECRET=change-me-to-a-strong-random-secret

# Server port (default: 8080)
PORT=8080
