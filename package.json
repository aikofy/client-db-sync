{
  "name": "@aikofy/client-db-sync",
  "version": "0.1.2",
  "description": "Minimal WebRTC signaling server for @aikofy/client-db with Ed25519 JWT auth",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "client-db-sync": "./dist/cli.js",
    "client-db-sync-keygen": "./dist/scripts/generate-keys.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunx tsup",
    "dev": "bunx tsup --watch & node --watch dist/index.js",
    "start": "node dist/index.js",
    "keygen": "bunx tsx scripts/generate-keys.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.0.0",
    "jose": "^5.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^11.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "author": "Lwin Maung Maung",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "webrtc",
    "signaling",
    "websocket",
    "p2p",
    "offline-first",
    "jwt",
    "ed25519"
  ]
}
